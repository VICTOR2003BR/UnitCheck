@page
@model AccessDeniedModel
@{
    ViewData["Title"] = "Acesso Negado";
}

<header>
    <h1 class="text-danger">@ViewData["Title"]</h1>
    <p class="text-danger">Você não tem permissão para acessar este recurso.</p>
</header>

<div class="alert alert-warning mt-4" role="alert">
    <strong>Status:</strong> Usuário logado, mas sem a Role necessária (Erro 403).
    <hr>
    <p>Se você acredita que deveria ter acesso, entre em contato com o Administrador do sistema.</p>
    
    @* Opcional: Link para a página inicial *@
    <a asp-area="" asp-controller="Home" asp-action="Index" class="btn btn-sm btn-primary">Voltar à Página Inicial</a>
</div>